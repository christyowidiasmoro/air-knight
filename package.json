{
  "name": "air-knight",
  "version": "1.0.0",
  "description": "A modular TypeScript Phaser mobile game built with CapacitorJS",
  "main": "dist/index.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint src --ext ts,tsx --fix",
    "type-check": "tsc --noEmit",
    "mobile:build": "npm run build && npx cap sync",
    "mobile:setup": "npx cap add android && npx cap add ios",
    "mobile:ios": "npx cap open ios",
    "mobile:android": "npx cap open android",
    "mobile:serve": "npx cap run ios --livereload-url=http://localhost:5173",
    "capacitor:sync": "npx cap sync",
    "capacitor:update": "npx cap update"
  },
  "keywords": [
    "phaser",
    "typescript",
    "mobile",
    "game",
    "capacitor"
  ],
  "author": "Air Knight Development Team",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.8.0",
    "@typescript-eslint/eslint-plugin": "^6.7.3",
    "@typescript-eslint/parser": "^6.7.3",
    "eslint": "^8.50.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.3",
    "jest": "^29.7.0",
    "prettier": "^3.0.3",
    "terser": "^5.44.0",
    "ts-jest": "^29.4.4",
    "typescript": "^5.2.2",
    "vite": "^4.4.9"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "optionalDependencies": {
    "@capacitor/android": "^5.4.1",
    "@capacitor/cli": "^5.7.8",
    "@capacitor/core": "^5.7.8",
    "@capacitor/ios": "^5.4.1"
  }
}
